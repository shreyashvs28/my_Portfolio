# Server
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
# If left blank/unreachable, the server still runs and saves messages
# to backend/data/messages.json as a fallback so the contact form keeps working.
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Nodemailer (Gmail example) - OPTIONAL.
# If left blank, emails are not sent but messages are still saved to
# MongoDB / the local fallback file, so the form still "works".
# For Gmail you must use an App Password, not your normal password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shreyashvs2809@gmail.com
SMTP_PASS=vrqs nfjt ondw brjn
CONTACT_RECEIVER_GMAIL=shreyashvs2809@gmail.com

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173


PORT=5000

# Your Gmail address that SENDS the email (and normally also receives it)
GMAIL_USER=shreyashvs2809@gmail.com

# Gmail APP PASSWORD (16 characters) - NOT your normal Gmail password.
# 1) Turn on 2-Step Verification: https://myaccount.google.com/security
# 2) Create an app password:      https://myaccount.google.com/apppasswords
# Paste it below (spaces are fine, they are removed automatically).
GMAIL_APP_PASSWORD=vrqs nfjt ondw brjn

# Where the messages should arrive (defaults to GMAIL_USER if empty)
CONTACT_RECEIVER_GMAIL=shreyashvs2809@gmail.com

# Allowed frontend origin(s) for CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173
